{
	"name": "df_silver_incidentes",
	"properties": {
		"folder": {
			"name": "Silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_incidentes_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_incidentes_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          IncidenteId as string,",
				"          TipoIncidente as string,",
				"          Severidad as string,",
				"          FechaHoraInicio as string,",
				"          FechaHoraFin as string,",
				"          FechaHoraRegistro as string,",
				"          VehiculoId as string,",
				"          Descripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(IncidenteId = trim(upper(IncidenteId)),",
				"          TipoIncidente = trim(upper(TipoIncidente)),",
				"          Severidad = trim(upper(Severidad)),",
				"          VehiculoId = trim(upper(VehiculoId)),",
				"          Descripcion = trim(Descripcion)) ~> derivedColumn1",
				"derivedColumn1 derive(FechaHoraInicio = iif(instr(toString(FechaHoraInicio), '/') > 0, toTimestamp(toString(FechaHoraInicio), 'dd/MM/yyyy HH:mm'), toTimestamp(toString(FechaHoraInicio), 'yyyy-MM-dd HH:mm:ss')),",
				"          FechaHoraFin = iif(instr(toString(FechaHoraFin), '/') > 0, toTimestamp(toString(FechaHoraFin), 'dd/MM/yyyy HH:mm'), toTimestamp(toString(FechaHoraFin), 'yyyy-MM-dd HH:mm:ss')),",
				"          FechaHoraRegistro = iif(instr(toString(FechaHoraRegistro), '/') > 0, toTimestamp(toString(FechaHoraRegistro), 'dd/MM/yyyy HH:mm'), toTimestamp(toString(FechaHoraRegistro), 'yyyy-MM-dd HH:mm:ss'))) ~> derivedColumn2",
				"derivedColumn2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          AnioFuente as integer,",
				"          IncidenteId as string,",
				"          TipoIncidente as string,",
				"          Severidad as string,",
				"          FechaHoraInicio as timestamp,",
				"          FechaHoraFin as timestamp,",
				"          FechaHoraRegistro as timestamp,",
				"          VehiculoId as string,",
				"          Descripcion as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}