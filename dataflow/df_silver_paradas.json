{
	"name": "df_silver_paradas",
	"properties": {
		"folder": {
			"name": "Silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          ParadaHistoricaId as string,",
				"          CodigoPublicado as string,",
				"          NombreParada as string,",
				"          Zona as string,",
				"          Latitud as string,",
				"          Longitud as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(NombreParada = trim(upper(NombreParada)),",
				"          Zona = trim(upper(Zona)),",
				"          Estado = trim(upper(Estado)),",
				"          ParadaHistoricaId = trim(ParadaHistoricaId),",
				"          CodigoPublicado = trim(CodigoPublicado),",
				"          VigenciaDesde = toDate(trim(VigenciaDesde), 'yyyy-MM-dd'),",
				"          VigenciaHasta = toDate(trim(VigenciaHasta), 'yyyy-MM-dd')) ~> derivedColumn1",
				"derivedColumn1 derive(Latitud = toFloat(trim(Latitud)),",
				"          Longitud = toFloat(trim(Longitud)),",
				"          AnioFuente = toInteger(trim(AnioFuente))) ~> derivedColumn2"
			]
		}
	}
}